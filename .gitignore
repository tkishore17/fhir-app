# ==============================================================================
# Python
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# ==============================================================================
# Git Internal / Local Tooling
# ==============================================================================
# local git files generated by certain IDEs or merge tools
*.orig
*.rej

# local git patch files or bundles that shouldn't be pushed
*.patch
*.diff

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing / Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nosenv/
.tox/
.nox/
.egg-info/

# MyPy / Black / Linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ==============================================================================
# Go (Golang)
# ==============================================================================
# Compiled binaries and external packages
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Output of the go coverage tool
*.out
*.prof

# Common IDE/Tooling artifacts for Go
vendor/

# Local configuration files generated by delve or other debugging tools
__debug_bin

# ==============================================================================
# JSON / YAML (Environment Secrets & Dynamic Configs)
# ==============================================================================
# Exclude actual local secrets or dynamic settings files.
# Rule of thumb: commit templates (*.example.json), ignore actual runtimes.
*secret*.json
*secret*.yaml
*secret*.yml
config.local.json
config.local.yaml
config.local.yml
.env*.json
.env*.yaml
.env*.yml

# ==============================================================================
# Operating Systems & Generic IDEs
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# JetBrains (PyCharm, GoLand)
.idea/
*.iws

# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace
